{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "tsup --watch --onSuccess \"node dist/index.cjs\"",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 100",
    "lint:strict": "eslint src/ --max-warnings 0",
    "test": "jest --detectOpenHandles",
    "setup-env": "tsx setup-env.ts",
    "test-db": "tsx test-db-connection.ts",
    "migrate:generate": "drizzle-kit generate --out migrations",
    "migrate:apply": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "count": "tsx src/runCount.ts",
    "count:help": "echo 'Usage: npm run count <electionId>' && echo 'Example: npm run count d93f6aa2-65ce-4fc9-bb69-0cb53f3840bb'",
    "create-admin": "tsx src/createAdmin.ts",
    "clear-db": "tsx src/clearDatabase.ts"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@repo/logger": "*",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.33.0",
    "express": "4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.31.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
